WORD_CORRECTIONS = {
    # Common speech-recognition errors
    "habar": "habari",
    "zenyu": "zenu",
    "Kar8buni": "Karibuni",

    # OCR/STT-like number substitutions
    "kar8buni": "karibuni",
    "kar8buni": "karibuni",

    # Church vocabulary
    "kaniani": "kanisani",
}


def normalize_words(text):

    result = text.strip()

    for wrong, right in WORD_CORRECTIONS.items():
        result = result.replace(wrong, right)

    return result


def lookup_phrase(text):

    key = text.strip().lower()

    return CHURCH_PHRASES.get(key)


def normalize(text):

    normalized = normalize_words(text)

    # IMPORTANT:
    # phrase lookup happens AFTER normalization.
    interpretation = lookup_phrase(normalized)

    return {
        "original": text,
        "normalized": normalized,
        "interpretation": interpretation,
        "matched": interpretation is not None,
    }


