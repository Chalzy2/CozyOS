def interpret_human_kiswahili_layer_2(text):
    """
    Human-style everyday Kiswahili interpretation layer 2.

    Handles common agreement, disagreement, feelings,
    requests, conversation control, and understanding phrases.
    """
    if not isinstance(text, str):
        return None

    normalized = normalize_words(text).strip()
    normalized = re.sub(r"\s+", " ", normalized)
    lowered = normalized.lower()

    # Remove ordinary sentence punctuation for natural input.
    lookup = lowered.rstrip("?!.,;:")

    return HUMAN_KISWAHILI_LAYER_2.get(lookup)


