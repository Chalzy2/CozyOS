import re


def interpret_church_sentence(text):
    """
    Interprets church phrases that contain variable names,
    locations, ministries, or organizations.

    Example:
        Karibuni kanisani Mavueni Newlife Kilifi
        ->
        Welcome to our church, Mavueni Newlife Kilifi
    """

    normalized = normalize_words(text).strip()

    # Normalize whitespace
    normalized = re.sub(r"\s+", " ", normalized)

    lowered = normalized.lower()

    # --------------------------------------------------------
    # WELCOME TO OUR CHURCH
    # --------------------------------------------------------
    # Standalone church welcome
    if lowered in ("karibuni kanisani", "karibu kanisani"):
        return "Welcome to our church."

    prefixes = (
        "karibuni kanisani ",
        "karibuni kanisani, ",
        "karibu kanisani ",
        "karibu kanisani, ",
    )

    for prefix in prefixes:

        if lowered.startswith(prefix):
            names = normalized[len(prefix):].strip()

            if names:
                return f"Welcome to our church, {names}."

            return "Welcome to our church."

    # --------------------------------------------------------
    # WELCOME TO THE SERVICE
    # --------------------------------------------------------
    if lowered == "karibuni katika ibada":
        return "Welcome to the service."

    if lowered == "karibuni katika ibada ya leo":
        return "Welcome to today's service."

    # --------------------------------------------------------
    # COMMON CHURCH EXPRESSIONS
    # --------------------------------------------------------
    if lowered == "habari ya leo?":
        return "How are you today?"

    if lowered == "habari za leo?":
        return "How are you today?"

    if lowered == "habari zenu siku ya leo?":
        return "How are you today?"

    if lowered == "bwana yesu asifiwe!":
        return "Praise the Lord Jesus!"

    if lowered == "bwana yesu asifiwe":
        return "Praise the Lord Jesus!"

    if lowered == "bwana asifiwe!":
        return "Praise the Lord!"

    if lowered == "bwana asifiwe":
        return "Praise the Lord!"

    if lowered == "mungu awabariki":
        return "May God bless you."

    if lowered == "mungu awabariki sana":
        return "May God richly bless you."

    if lowered == "ndugu zangu":
        return "My brethren."

    if lowered == "leo tunamshukuru mungu kwa wema wake.":
        return "Today we are grateful to God for His goodness."

    if lowered == "mungu akubariki":
        return "May God bless you."

    if lowered == "tumsifu mungu":
        return "Let us praise God."

    if lowered == "tuombe":
        return "Let us pray."

    return None

