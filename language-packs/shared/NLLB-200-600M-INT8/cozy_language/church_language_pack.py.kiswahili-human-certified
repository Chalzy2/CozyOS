def interpret_human_kiswahili(text):
    """
    Interpret common natural Kiswahili conversation.

    Returns an English interpretation for known human expressions,
    otherwise None so the normal church/NLLB pipeline can continue.
    """
    if not isinstance(text, str):
        return None

    normalized = normalize_words(text)
    normalized = re.sub(r"\s+", " ", normalized).strip()
    lowered = normalized.lower()

    # Direct human phrase
    meaning = HUMAN_SW_PHRASES.get(lowered)
    if meaning is not None:
        return meaning

    # Known variant -> canonical human phrase
    canonical = HUMAN_SW_VARIANTS.get(lowered)
    if canonical is not None:
        return HUMAN_SW_PHRASES.get(canonical)

    return None


